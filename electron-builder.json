{
  "appId": "com.zain.ai-harness",
  "productName": "Dev3",
  "artifactName": "dev3-setup.${ext}",
  "directories": {
    "output": "out/nsis"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "Zain-Repo",
      "repo": "ai-app"
    }
  ],
  "executableName": "dev3",
  "win": {
    "icon": "public/icons/icon-512.png",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Dev3",
    "runAfterFinish": true,
    "deleteAppDataOnUninstall": true
  }
}
