{
  "name": "ai-app",
  "productName": "AI Harness",
  "version": "0.1.9",
  "description": "AI Harness desktop client",
  "author": "Zain Ahmad",
  "main": ".vite/build/index.cjs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "desktop:dev": "bun scripts/run-electron-dev.mjs",
    "desktop:start": "electron-forge start",
    "desktop:codex:smoke": "node scripts/smoke-codex-app-server.mjs",
    "build": "vite build",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "check": "prettier --check \"**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "tsc --noEmit",
    "terminal:image:build": "docker build -t ai-harness-terminal:local workers/terminal/image",
    "terminal:worker": "bun workers/terminal/index.ts",
    "package:client": "bun scripts/run-forge-package.ts --role=client --platform=win32",
    "package:client:local": "bun scripts/run-forge-package.ts --role=client --platform=win32 --local-only",
    "package:client:store": "bun scripts/run-forge-package.ts --role=client --platform=win32 --store",
    "installer:nsis": "bun scripts/build-nsis-installer.mjs",
    "installer:windows": "bun run package:client && bun run installer:nsis",
    "installer:windows:local": "bun run package:client:local && bun scripts/build-nsis-installer.mjs --local-only",
    "installer:store": "bun run package:client:store && bun scripts/build-store-appx.mjs",
    "updater:publish": "bun scripts/publish-updater-release.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.0",
    "@base-ui/react": "^1.6.0",
    "@clerk/tanstack-react-start": "^1.4.20",
    "@clerk/ui": "^1.25.5",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/raleway": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/react": "^1.1.9",
    "@openai/codex": "^0.145.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@remotion/player": "^4.0.496",
    "@shadcn/react": "^0.2.1",
    "@streamdown/math": "1.0.2",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "latest",
    "ai": "^7.0.0",
    "ansi-to-react": "^6.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.42.3",
    "date-fns": "^4.4.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.25.0",
    "motion": "^12.42.2",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.6",
    "react-resizable-panels": "^4.12.2",
    "recharts": "3.8.0",
    "remotion": "^4.0.496",
    "shadcn": "^4.13.1",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron-forge/shared-types": "^7.11.1",
    "@electron/asar": "^3.4.1",
    "@electron/fuses": "^1.8.0",
    "@electron/windows-sign": "1.2.2",
    "@cloudflare/vite-plugin": "^1.45.0",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "convex-test": "^0.0.54",
    "electron": "40.2.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "jsdom": "^28",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6",
    "vite": "^8",
    "vitest": "^4",
    "wrangler": "^4.107.0"
  }
}
